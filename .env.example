# Copy to .env and fill in. NEVER commit .env.
# Private key of the wallet that signs orders (export from Polymarket: Settings -> Export private key,
# or your browser wallet). Hex string, with or without 0x.
POLY_PRIVATE_KEY=
# Address that HOLDS the USDC / positions on Polymarket = the address shown on your Polymarket profile.
POLY_FUNDER=
# 0 = plain EOA wallet trading directly, 1 = Polymarket email/Magic login, 2 = browser-wallet (MetaMask) proxy.
POLY_SIGNATURE_TYPE=1
